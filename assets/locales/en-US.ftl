       *[other] { $name } throughput over the last { $seconds } seconds, currently { $rate }
    }
tm-state-sub-state = { $state } ({ $substate })
tm-byte-count = { $count ->
        [one] { $count } byte ({ $size })
       *[other] { $count } bytes ({ $size })
    }
tm-utilization-reading = { $percent }% utilization
tm-uptime-days = { $days }d { $clock }
tm-uptime-clock = { $clock }

tm-shell-managing-action = Managing a process or service
